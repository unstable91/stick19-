<Window x:Class="DesktopStickyNote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="stick19"
        Height="320" Width="340"
        MinHeight="180" MinWidth="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Paragraph spacing for natural sticky note lines -->
        <Style TargetType="{x:Type Paragraph}">
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- Dynamic Theme Brushes for Menu & Controls -->
        <SolidColorBrush x:Key="MenuBgBrush" Color="#FFF099"/>
        <SolidColorBrush x:Key="MenuFgBrush" Color="#202020"/>
        <SolidColorBrush x:Key="MenuBorderBrush" Color="#E0D283"/>
        <SolidColorBrush x:Key="MenuHoverBrush" Color="#EADF82"/>
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#55826A00"/>

        <!-- Themed Separator Style -->
        <Style x:Key="ThemedSeparatorStyle" TargetType="{x:Type Separator}">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Background" Value="{DynamicResource MenuBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Background="{TemplateBinding Background}" Height="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Themed MenuItem Style with Submenu & Checkmark Support -->
        <Style x:Key="ThemedMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuFgBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid>
                            <Border x:Name="bgBorder" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" SharedSizeGroup="MenuItemIconColumnGroup"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemGestureColumnGroup"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkmark / Icon -->
                                    <ContentPresenter x:Name="Icon" Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <Path x:Name="CheckMark" Grid.Column="0" Data="M 2,5.5 L 5,8.5 L 10,2" Stroke="{DynamicResource MenuFgBrush}" StrokeThickness="1.8" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="10"/>

                                    <!-- Header text -->
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="4,0,12,0"/>

                                    <!-- Submenu Arrow -->
                                    <Path x:Name="SubmenuArrow" Grid.Column="2" Data="M 0,0 L 4,3.5 L 0,7" Fill="{DynamicResource MenuFgBrush}" Visibility="Collapsed" VerticalAlignment="Center" Margin="6,0,2,0"/>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right">
                                <Border Background="{DynamicResource MenuBgBrush}" BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" Opacity="0.22" ShadowDepth="3" Direction="270" Color="#000000"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bgBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Themed ContextMenu Style -->
        <Style x:Key="ThemedContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="{DynamicResource MenuBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.22" ShadowDepth="3" Direction="270" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Modern Thin ScrollBar Styles -->
        <Style x:Key="ModernThinScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBorder"
                                Background="{DynamicResource ScrollThumbBrush}"
                                CornerRadius="3"
                                Margin="1,2"
                                Opacity="0.6"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBorder" Property="Opacity" Value="1.0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="MinWidth" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="True">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ModernThinScrollThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Clean header button style -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#25000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#40000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Formatting ToggleButton Style for Bold, Italic, Underline (Focusable=False) -->
        <Style x:Key="FormatToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="fmtBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fmtBorder" Property="Background" Value="#20000000"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="fmtBorder" Property="Background" Value="#35000000"/>
                                <Setter TargetName="fmtBorder" Property="BorderBrush" Value="#45000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer container with padding for drop shadow -->
    <Grid Margin="10">
        <Border x:Name="RootBorder"
                CornerRadius="8"
                BorderThickness="1"
                Background="#FFF8CC"
                BorderBrush="#E0D283"
                Opacity="0.90">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Opacity="0.18" ShadowDepth="3" Direction="270" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>  <!-- Header -->
                    <RowDefinition Height="*"/>   <!-- Text Area -->
                    <RowDefinition Height="26"/>  <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- Glossy Glass Sheen Reflection Highlight Overlay -->
                <Border x:Name="GlossyHighlight"
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        CornerRadius="8,8,0,0"
                        Height="75"
                        VerticalAlignment="Top"
                        Panel.ZIndex="10"
                        IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#40FFFFFF" Offset="0.0"/>
                            <GradientStop Color="#15FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 1. Header Bar -->
                <Border x:Name="HeaderBorder"
                        Grid.Row="0"
                        Background="#FFF099"
                        CornerRadius="8,8,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Pin/Drag hint -->
                            <ColumnDefinition Width="*"/>    <!-- Draggable space -->
                            <ColumnDefinition Width="Auto"/> <!-- Action buttons -->
                        </Grid.ColumnDefinitions>

                        <!-- Left icon indicator -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Path x:Name="PinPath"
                                  Data="M 4,2 L 8,2 L 8,6 L 10,8 L 10,9 L 7,9 L 7,14 L 5,14 L 5,9 L 2,9 L 2,8 L 4,6 Z"
                                  Fill="#7A6F28"
                                  Width="12" Height="14"
                                  Stretch="Uniform"
                                  ToolTip="stick19 - Attached to Windows Desktop layer"/>
                            <TextBlock x:Name="LockedIndicator"
                                       Text="🔒"
                                       FontSize="10"
                                       Margin="6,0,0,0"
                                       Visibility="Collapsed"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Draggable title / middle space -->
                        <TextBlock Grid.Column="1"
                                   Text=""
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>

                        <!-- Right Header Buttons: Settings (Gear), Lock, Close -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                            <!-- Settings Button (Replaced color/palette button, opens themed Settings menu) -->
                            <Button x:Name="BtnSettings"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    ToolTip="Settings &amp; Options"
                                    Click="BtnSettings_Click">
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="SettingsMenu" Style="{StaticResource ThemedContextMenuStyle}">
                                        <!-- 1. Color Themes Submenu -->
                                        <MenuItem x:Name="MenuThemeParent" Header="Color Theme" Style="{StaticResource ThemedMenuItemStyle}">
                                            <MenuItem Header="Classic Yellow" Tag="Yellow" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuThemeItem_Click"/>
                                            <MenuItem Header="Soft Mint" Tag="Mint" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuThemeItem_Click"/>
                                            <MenuItem Header="Sky Blue" Tag="Blue" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuThemeItem_Click"/>
                                            <MenuItem Header="Lavender" Tag="Lavender" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuThemeItem_Click"/>
                                            <MenuItem Header="Warm Peach" Tag="Peach" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuThemeItem_Click"/>
                                            <MenuItem Header="Charcoal Dark" Tag="Dark" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuThemeItem_Click"/>
                                        </MenuItem>

                                        <!-- 2. Font Size Submenu -->
                                        <MenuItem x:Name="MenuFontParent" Header="Font Size" Style="{StaticResource ThemedMenuItemStyle}">
                                            <MenuItem Header="Small (11 pt)" Tag="11" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuFontSizeItem_Click"/>
                                            <MenuItem Header="Normal (13 pt)" Tag="13" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuFontSizeItem_Click"/>
                                            <MenuItem Header="Medium (15 pt)" Tag="15" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuFontSizeItem_Click"/>
                                            <MenuItem Header="Large (18 pt)" Tag="18" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuFontSizeItem_Click"/>
                                            <MenuItem Header="Extra Large (22 pt)" Tag="22" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuFontSizeItem_Click"/>
                                        </MenuItem>

                                        <!-- 3. Transparency Submenu -->
                                        <MenuItem x:Name="MenuOpacityParent" Header="Transparency / Opacity" Style="{StaticResource ThemedMenuItemStyle}">
                                            <MenuItem Header="100% (Solid)" Tag="1.0" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuOpacityItem_Click"/>
                                            <MenuItem Header="90% (Subtle)" Tag="0.9" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuOpacityItem_Click"/>
                                            <MenuItem Header="80% (Glossy)" Tag="0.8" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuOpacityItem_Click"/>
                                            <MenuItem Header="70%" Tag="0.7" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuOpacityItem_Click"/>
                                            <MenuItem Header="60%" Tag="0.6" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuOpacityItem_Click"/>
                                            <MenuItem Header="50%" Tag="0.5" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuOpacityItem_Click"/>
                                            <MenuItem Header="40% (Ultra Glass)" Tag="0.4" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuOpacityItem_Click"/>
                                        </MenuItem>

                                        <!-- 4. Glossy Effect -->
                                        <MenuItem x:Name="MenuOptGlossy" Header="Glossy Glass Sheen" IsCheckable="True" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuOptGlossy_Click"/>

                                        <!-- 5. Auto-Save -->
                                        <MenuItem x:Name="MenuOptAutoSave" Header="Auto-Save" IsCheckable="True" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuOptAutoSave_Click"/>

                                        <!-- 6. Lock Note -->
                                        <MenuItem x:Name="MenuOptLock" Header="Lock Note (Prevent Move/Resize)" IsCheckable="True" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuOptLock_Click"/>

                                        <Separator Style="{StaticResource ThemedSeparatorStyle}"/>

                                        <!-- 7. Windows Startup -->
                                        <MenuItem x:Name="MenuOptStartup" Header="Launch at Windows Startup" IsCheckable="True" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuOptStartup_Click"/>

                                        <!-- 8. Desktop Layer Mode Submenu -->
                                        <MenuItem Header="Desktop Layer Mode" Style="{StaticResource ThemedMenuItemStyle}">
                                            <MenuItem x:Name="MenuOptModeBottom" Header="Desktop Bottom Layer (Recommended for Win 11)" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuOptModeBottom_Click"/>
                                            <MenuItem x:Name="MenuOptModeWorkerW" Header="WorkerW Shell Child (Direct reparenting)" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuOptModeWorkerW_Click"/>
                                        </MenuItem>

                                        <!-- 9. Center on Screen -->
                                        <MenuItem Header="Center on Screen" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuCenter_Click"/>

                                        <Separator Style="{StaticResource ThemedSeparatorStyle}"/>

                                        <!-- 10. About -->
                                        <MenuItem Header="About stick19" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuAbout_Click"/>

                                        <!-- 11. Exit -->
                                        <MenuItem Header="Exit Application" Style="{StaticResource ThemedMenuItemStyle}" Click="MenuExit_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>

                                <!-- Fluent Gear / Settings Icon -->
                                <Path x:Name="SettingsIconPath"
                                      Data="M 12,15.5 C 10.07,15.5 8.5,13.93 8.5,12 C 8.5,10.07 10.07,8.5 12,8.5 C 13.93,8.5 15.5,10.07 15.5,12 C 15.5,13.93 13.93,15.5 12,15.5 Z M 19.43,12.97 C 19.47,12.65 19.5,12.33 19.5,12 C 19.5,11.67 19.47,11.34 19.43,11.03 L 21.54,9.37 C 21.73,9.22 21.78,8.95 21.66,8.73 L 19.66,5.27 C 19.54,5.05 19.27,4.97 19.05,5.05 L 16.56,6.05 C 16.04,5.65 15.48,5.32 14.87,5.07 L 14.49,2.42 C 14.46,2.18 14.25,2 14,2 L 10,2 C 9.75,2 9.54,2.18 9.51,2.42 L 9.13,5.07 C 8.52,5.32 7.96,5.66 7.44,6.05 L 4.95,5.05 C 4.73,4.96 4.46,5.05 4.34,5.27 L 2.34,8.73 C 2.21,8.95 2.27,9.22 2.46,9.37 L 4.57,11.03 C 4.53,11.34 4.5,11.67 4.5,12 C 4.5,12.33 4.53,12.65 4.57,12.97 L 2.46,14.63 C 2.27,14.78 2.21,15.05 2.34,15.27 L 4.34,18.73 C 4.46,18.95 4.73,19.03 4.95,18.95 L 7.44,17.95 C 7.96,18.35 8.52,18.68 9.13,18.93 L 9.51,21.58 C 9.54,21.82 9.75,22 10,22 L 14,22 C 14.25,22 14.46,21.82 14.49,21.58 L 14.87,18.93 C 15.48,18.68 16.04,18.34 16.56,17.95 L 19.05,18.95 C 19.28,19.04 19.54,18.95 19.66,18.73 L 21.66,15.27 C 21.78,15.05 21.73,14.78 21.54,14.63 L 19.43,12.97 Z"
                                      Fill="#555025"
                                      Width="13" Height="13"
                                      Stretch="Uniform"/>
                            </Button>

                            <!-- Lock Position Toggle -->
                            <Button x:Name="BtnLock"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    ToolTip="Lock note position and size"
                                    Click="BtnLock_Click">
                                <Path x:Name="LockIconPath"
                                      Data="M 12,2 C 9.79,2 8,3.79 8,6 L 8,8 L 6,8 C 4.9,8 4,8.9 4,10 L 4,20 C 4,21.1 4.9,22 6,22 L 18,22 C 19.1,22 20,21.1 20,20 L 20,10 C 20,8.9 19.1,8 18,8 L 16,8 L 16,6 C 16,3.79 14.21,2 12,2 Z M 10,6 C 10,4.9 10.9,4 12,4 C 13.1,4 14,4.9 14,6 L 14,8 L 10,8 L 10,6 Z"
                                      Fill="#555025"
                                      Width="13" Height="13"
                                      Stretch="Uniform"/>
                            </Button>

                            <!-- Hide / Minimize to Tray -->
                            <Button x:Name="BtnClose"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    ToolTip="Hide to system tray"
                                    Click="BtnClose_Click">
                                <Path x:Name="CloseIconPath"
                                      Data="M 19,6.41 L 17.59,5 L 12,10.59 L 6.41,5 L 5,6.41 L 10.59,12 L 5,17.59 L 6.41,19 L 12,13.41 L 17.59,19 L 19,17.59 L 13.41,12 Z"
                                      Fill="#555025"
                                      Width="12" Height="12"
                                      Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Text Area (RichTextBox with no right-click context menu, thin scrollbar) -->
                <Grid Grid.Row="1" Margin="12,6,8,4">
                    <!-- Placeholder text when empty -->
                    <TextBlock x:Name="PlaceholderText"
                               Text="Take a note..."
                               Foreground="#888888"
                               FontStyle="Italic"
                               FontSize="14"
                               Margin="4,2,0,0"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"/>

                    <!-- Main RichTextBox -->
                    <RichTextBox x:Name="NoteRichTextBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#202020"
                                 FontSize="14"
                                 FontFamily="Segoe UI, Segoe UI Variable, Arial"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 SpellCheck.IsEnabled="False"
                                 ContextMenu="{x:Null}"
                                 Padding="2,2,4,2"
                                 TextChanged="NoteRichTextBox_TextChanged"
                                 SelectionChanged="NoteRichTextBox_SelectionChanged"
                                 PreviewKeyDown="NoteRichTextBox_PreviewKeyDown"
                                 ContextMenuOpening="NoteRichTextBox_ContextMenuOpening"
                                 PreviewMouseRightButtonUp="NoteRichTextBox_PreviewMouseRightButtonUp"/>
                </Grid>

                <!-- 3. Footer Bar: Formatting B, I, U on Left, Only "Saved" or "Unsaved" in Middle, Corner Gripper on Right -->
                <Grid Grid.Row="2" Margin="10,0,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- B, I, U Buttons -->
                        <ColumnDefinition Width="*"/>    <!-- Saved / Unsaved Status -->
                        <ColumnDefinition Width="Auto"/> <!-- Resize Gripper Visual -->
                    </Grid.ColumnDefinitions>

                    <!-- Formatting Toolbar: B, I, U (Focusable=False so text selection stays active) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="BtnBold"
                                      Style="{StaticResource FormatToggleStyle}"
                                      ToolTip="Bold (Ctrl+B)"
                                      Click="BtnBold_Click">
                            <TextBlock Text="B" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource MenuFgBrush}"/>
                        </ToggleButton>

                        <ToggleButton x:Name="BtnItalic"
                                      Style="{StaticResource FormatToggleStyle}"
                                      ToolTip="Italic (Ctrl+I)"
                                      Click="BtnItalic_Click">
                            <TextBlock Text="I" FontStyle="Italic" FontWeight="SemiBold" FontFamily="Georgia, Times New Roman, Serif" FontSize="11" Foreground="{DynamicResource MenuFgBrush}"/>
                        </ToggleButton>

                        <ToggleButton x:Name="BtnUnderline"
                                      Style="{StaticResource FormatToggleStyle}"
                                      ToolTip="Underline (Ctrl+U)"
                                      Click="BtnUnderline_Click">
                            <TextBlock Text="U" TextDecorations="Underline" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource MenuFgBrush}"/>
                        </ToggleButton>
                    </StackPanel>

                    <!-- Save Status (Only "Saved" or "Unsaved" + [Save] button when AutoSave is off) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock x:Name="TxtSaveStatus"
                                   Text="Saved"
                                   FontSize="11"
                                   Foreground="#888888"
                                   VerticalAlignment="Center"/>

                        <Button x:Name="BtnSaveManual"
                                Content="Save"
                                FontSize="10"
                                Padding="5,1"
                                Margin="6,0,0,0"
                                Cursor="Hand"
                                Visibility="Collapsed"
                                Click="BtnSaveManual_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#1F000000"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="{DynamicResource MenuFgBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#35000000"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Corner Gripper Visual -->
                    <Path Grid.Column="2"
                          Data="M 8,0 L 8,8 L 0,8 Z M 4,4 L 4,8 L 0,8 Z"
                          Fill="#888888"
                          Width="8" Height="8"
                          Stretch="Uniform"
                          Opacity="0.4"
                          Margin="0,0,2,2"
                          VerticalAlignment="Bottom"
                          HorizontalAlignment="Right"
                          IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 8 Interactive Resize Handles for smooth edge/corner dragging -->
        <Thumb x:Name="ThumbTop" Height="8" VerticalAlignment="Top" HorizontalAlignment="Stretch" Cursor="SizeNS" Opacity="0" DragDelta="ThumbTop_DragDelta"/>
        <Thumb x:Name="ThumbBottom" Height="8" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Cursor="SizeNS" Opacity="0" DragDelta="ThumbBottom_DragDelta"/>
        <Thumb x:Name="ThumbLeft" Width="8" HorizontalAlignment="Left" VerticalAlignment="Stretch" Cursor="SizeWE" Opacity="0" DragDelta="ThumbLeft_DragDelta"/>
        <Thumb x:Name="ThumbRight" Width="8" HorizontalAlignment="Right" VerticalAlignment="Stretch" Cursor="SizeWE" Opacity="0" DragDelta="ThumbRight_DragDelta"/>
        <Thumb x:Name="ThumbTopLeft" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Opacity="0" DragDelta="ThumbTopLeft_DragDelta"/>
        <Thumb x:Name="ThumbTopRight" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Opacity="0" DragDelta="ThumbTopRight_DragDelta"/>
        <Thumb x:Name="ThumbBottomLeft" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Opacity="0" DragDelta="ThumbBottomLeft_DragDelta"/>
        <Thumb x:Name="ThumbBottomRight" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Opacity="0" DragDelta="ThumbBottomRight_DragDelta"/>
    </Grid>
</Window>
